# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/convertify

# Auth
JWT_SECRET=change-this-in-prod

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# SMTP (OTP emails)
SMTP_USER=
SMTP_PASS=

# Python microservice (word/excel/ppt <-> pdf, PDF compression, thumbnails, TTS, STT -
# runs LibreOffice + Ghostscript, which don't fit Vercel's serverless functions) -
# deploy separately (see python_service/), must be reachable from Vercel.
PYTHON_SERVICE_URL=http://localhost:8001

# Shared secret with the Python microservice - must match PYTHON_SERVICE_SECRET set on
# that service's own environment. Without it set on both sides, anyone who can reach
# PYTHON_SERVICE_URL directly can call /convert/* for free, bypassing rate limiting.
PYTHON_SERVICE_SECRET=change-this-in-prod

# Vercel Cron auth (checked by /api/cron/cleanup)
CRON_SECRET=change-this-in-prod
